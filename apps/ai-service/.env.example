# AI Service Configuration
INTERNAL_API_KEY=<same-value-as-backend-internal-api-key, at least 32 characters>
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_BASE_URL=<optional-provider-base-url>
LLM_API_KEY=<optional-provider-api-key>
LLM_PROVIDER=gemini

GEMINI_API_KEY=<gemini-api-key>
LLM_MODEL=gemini-3.5-flash-lite

MAX_DOCUMENT_SIZE_MB=20
MAX_DOCUMENT_FILES=20
MAX_DOCUMENT_TOTAL_SIZE_MB=100
MAX_COMBINED_DOCUMENT_CHARACTERS=500000
MAX_GENERATED_QUESTIONS=50

# LibreOffice Configuration
QUESTION_GENERATION_TIMEOUT_SECONDS=120
LIBREOFFICE_PATH=<path-to-libreoffice-executable>
LIBREOFFICE_CONVERSION_TIMEOUT_SECONDS=60

# MediaPipe instances per process. For scale, run several processes instead:
#   uvicorn app.main:app --port 8000 --workers <number of CPU cores>
# (the service is stateless, so workers can share the load)
FACE_ANALYZER_POOL=1
