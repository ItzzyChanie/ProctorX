INTERNAL_API_KEY=<same-value-as-backend-internal-api-key>
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
REDIS_URL=redis://localhost:6379/0
LLM_BASE_URL=<optional-provider-base-url>
LLM_API_KEY=<optional-provider-api-key>
LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
LLM_MODEL=gemini-3.5-flash-lite
MAX_DOCUMENT_SIZE_MB=20
MAX_DOCUMENT_CHARACTERS=100000
MAX_GENERATED_QUESTIONS=50
QUESTION_GENERATION_TIMEOUT_SECONDS=120
LIBREOFFICE_PATH=<path-to-libreoffice-executable>
LIBREOFFICE_CONVERSION_TIMEOUT_SECONDS=60
