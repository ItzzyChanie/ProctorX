# Database Connection and Authentication
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
JWT_SECRET=<generate-a-long-random-secret, at least 32 characters>
JWT_EXPIRES_IN=7d
AUTH_COOKIE_MAX_AGE_MS=604800000

# SMTP Configuration for Email Delivery
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-app-password>
SMTP_FROM="<display-name> <<sender-email>>"

# Institution directory (optional override; manual entry remains available)
UNIVERSITY_SEARCH_API_URL=http://universities.hipolabs.com/search

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=<generate-and-share-with-ai-service, at least 32 characters>

# Seeded Initial User Credentials for demo
SEED_DEAN_EMAIL=<dean-email>
SEED_DEAN_PASSWORD=<dean-password>
SEED_DEAN_FULLNAME=<dean-full-name>
SEED_TEACHER_EMAIL=<teacher-email>
SEED_TEACHER_PASSWORD=<teacher-password>
SEED_TEACHER_FULLNAME=<teacher-full-name>
SEED_STUDENT_LOGIN_ID=<student-login-id>
SEED_STUDENT_EMAIL=<student-email>
SEED_STUDENT_PASSWORD=<student-password>
SEED_STUDENT_FULLNAME=<student-full-name>

# Live screen monitoring
# Comma-separated browser origins allowed for HTTP + Socket.IO (defaults to localhost:5173/5174)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to share Socket.IO rooms across multiple backend instances (redis service in docker-compose)
# REDIS_URL=redis://localhost:6379
# WebRTC ICE servers. TURN is strongly recommended for school/campus networks.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# coturn "static-auth-secret" (preferred, issues short-lived credentials)...
TURN_SECRET=
TURN_TTL_SECONDS=21600
# ...or static TURN credentials
TURN_USERNAME=
TURN_CREDENTIAL=

# Data retention: screen recordings and evidence clips are deleted this many
# days after an attempt ends (default 180).
EVIDENCE_RETENTION_DAYS=180
# Set when running behind a reverse proxy so rate limits see real client IPs
# (number of proxy hops, e.g. 1).
# TRUST_PROXY=1

# Database connection pool per backend instance (Prisma). Keep the total across
# all running backend instances below Postgres max_connections (default 100).
DB_POOL_SIZE=30
DB_POOL_TIMEOUT=20

# How often each student's browser sends a camera snapshot / audio sample for
# AI analysis (seconds). Lower = faster detection but more server load.
FACE_SAMPLE_SECONDS=10
AUDIO_SAMPLE_SECONDS=10
