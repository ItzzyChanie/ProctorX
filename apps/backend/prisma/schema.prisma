generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  DEAN
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum InstitutionRegistrationStatus {
  EMAIL_VERIFICATION_PENDING
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ImportRowResult {
  CREATED
  SKIPPED_DUPLICATE
  ERROR
}

enum Program {
  CS
  IT
}

enum YearLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
}

enum QuestionType {
  MULTIPLE_CHOICE
  ENUMERATION
  ESSAY
  IDENTIFICATION
}

enum ExamSourceType {
  MANUAL
  GOOGLE_FORMS_IMPORT
  AI_GENERATED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  EXAM
  QUIZ
}

enum Semester {
  FIRST
  SECOND
}

enum AcademicTerm {
  UNSPECIFIED
  PRELIMINARY
  MIDTERM
  SEMI_FINAL
  FINAL
}

enum AcademicPeriodStatus {
  ACTIVE
  CLOSED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum AppPolicyMode {
  BLACKLIST
  WHITELIST
}

enum GradeStatus {
  UNGRADED
  AUTO_GRADED
  AI_SUGGESTED
  TEACHER_CONFIRMED
}

enum SubmissionMode {
  MANUAL
  AUTO_TIMEOUT
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  DISCONNECTED
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum EventType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  FACE_NOT_VISIBLE
  EXCESSIVE_EYE_MOVEMENT
  POSSIBLE_TALKING
  MULTIPLE_FACES_DETECTED
  VOICE_DETECTED
  BLACKLISTED_APP
  USB_EVENT
  IDLE
}

enum RecordingStatus {
  UPLOADING
  COMPLETE
  FAILED
}

enum EvidenceClipStatus {
  UPLOADING
  COMPLETE
  FAILED
}

enum EvidenceClipPhase {
  BEFORE
  AFTER
  PREVIOUS
  INCIDENT
  FOLLOWING
  CENTERED
}

enum ReportFormat {
  PDF
  EXCEL
}

enum ReportJobStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ProctorReviewDecision {
  PENDING
  NEGATIVE
  POSITIVE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id                    String                @id @default(uuid())
  institutionId         String?
  role                  Role
  loginId               String                @unique
  email                 String?               @unique
  passwordHash          String
  fullName              String
  profilePicture        String?               @db.Text
  mustChangePassword    Boolean               @default(true)
  isActive              Boolean               @default(true)
  status                AccountStatus         @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  permissionOverrides   UserPermission[]
  deanProfile           DeanProfile?
  teacherProfile        TeacherProfile?
  studentProfile        StudentProfile?
  activationCodes       ActivationCode[]
  uploadedImportBatches StudentImportBatch[]  @relation("ImportBatchUploader")
  taughtSubjects        Subject[]             @relation("SubjectTeacher")
  enrollments           Enrollment[]
  subjectJoinRequests   SubjectJoinRequest[]
  examSessions          ExamSession[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  studentLoginSession   StudentLoginSession?
  requestedReports      GeneratedReport[]
  questionBankItems     QuestionBankItem[]
  examStudentOverrides  ExamStudentOverride[]
  proctorReviews        ProctorReview[]       @relation("ProctorReviewTeacher")
  proctorWarnings       ProctorWarning[]      @relation("ProctorWarningTeacher")

  @@index([institutionId, role])
  @@map("users")
}

model StudentLoginSession {
  id         String   @id
  userId     String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("student_login_sessions")
}

model DeanProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  employeeId      String?  @unique
  college         String?
  title           String?
  institutionName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dean_profiles")
}

model InstitutionRegistration {
  id                    String                        @id @default(uuid())
  referenceNumber       String                        @unique
  institutionName       String
  collegeDepartmentName String
  schoolType            String
  firstName             String
  lastName              String
  employeeId            String?
  officialTitle         String
  email                 String                        @unique
  passwordHash          String
  internalRole          String                        @default("INSTITUTION_ADMINISTRATOR")
  status                InstitutionRegistrationStatus @default(EMAIL_VERIFICATION_PENDING)
  authorityConfirmed    Boolean                       @default(false)
  termsAccepted         Boolean                       @default(false)
  privacyAccepted       Boolean                       @default(false)
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int                           @default(0)
  emailVerifiedAt       DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([status, createdAt])
  @@map("institution_registrations")
}

model TeacherProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  employeeId   String?     @unique
  title        String?
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@map("teacher_profiles")
}

model Department {
  id            String           @id @default(uuid())
  institutionId String
  code          String
  name          String
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  faculty       TeacherProfile[]

  @@unique([institutionId, code])
  @@unique([institutionId, name])
  @@index([institutionId, isActive])
  @@map("departments")
}

model StudentProfile {
  id        String          @id @default(uuid())
  userId    String          @unique
  studentId String?         @unique
  yearLevel String?
  program   String?
  sectionId String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   StudentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@map("student_profiles")
}

model StudentSection {
  id                 String           @id @default(uuid())
  institutionId      String?
  name               String
  program            String
  yearLevel          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  students           StudentProfile[]
  subjectAssignments SubjectSection[]

  @@unique([institutionId, program, yearLevel, name])
  @@index([institutionId])
  @@index([program, yearLevel])
  @@map("student_sections")
}

model GeneratedReport {
  id            String          @id @default(uuid())
  requestedById String
  name          String
  format        ReportFormat
  dateFrom      DateTime
  dateTo        DateTime
  filters       Json?
  status        ReportJobStatus @default(PENDING)
  downloadPath  String?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  staleAt       DateTime?
  requestedBy   User            @relation(fields: [requestedById], references: [id])

  @@index([requestedById, createdAt])
  @@map("generated_reports")
}

model Permission {
  id            String           @id @default(uuid())
  key           String           @unique
  description   String
  userOverrides UserPermission[]

  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model ActivationCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_codes")
}

model StudentImportBatch {
  id           String             @id @default(uuid())
  uploadedById String
  fileName     String
  totalRows    Int
  createdRows  Int
  skippedRows  Int
  errorRows    Int
  createdAt    DateTime           @default(now())
  uploadedBy   User               @relation("ImportBatchUploader", fields: [uploadedById], references: [id])
  rows         StudentImportRow[]

  @@index([uploadedById])
  @@map("student_import_batches")
}

model StudentImportRow {
  id           String             @id @default(uuid())
  batchId      String
  rowNumber    Int
  studentId    String?
  fullName     String?
  email        String?
  result       ImportRowResult
  errorMessage String?
  batch        StudentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("student_import_rows")
}

model Subject {
  id                 String               @id @default(uuid())
  code               String               @unique
  subjectCode        String?
  schedule           String?
  name               String
  teacherId          String
  createdAt          DateTime             @default(now())
  teacher            User                 @relation("SubjectTeacher", fields: [teacherId], references: [id])
  enrollments        Enrollment[]
  joinRequests       SubjectJoinRequest[]
  exams              Exam[]
  sectionAssignments SubjectSection[]
  questionBankItems  QuestionBankItem[]

  @@unique([teacherId, subjectCode])
  @@index([teacherId])
  @@map("subjects")
}

model SubjectJoinRequest {
  id              String            @id @default(uuid())
  subjectId       String
  studentId       String
  status          JoinRequestStatus @default(PENDING)
  requestedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  studentHiddenAt DateTime?
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student         User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId])
  @@index([subjectId, status])
  @@index([studentId, status])
  @@index([studentId, studentHiddenAt])
  @@map("subject_join_requests")
}

model Enrollment {
  id         String   @id @default(uuid())
  subjectId  String
  studentId  String
  enrolledAt DateTime @default(now())
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId])
  @@index([studentId])
  @@map("enrollments")
}

model SubjectSection {
  id        String         @id @default(uuid())
  subjectId String
  sectionId String
  createdAt DateTime       @default(now())
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section   StudentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([subjectId, sectionId])
  @@index([sectionId])
  @@map("subject_sections")
}

model Exam {
  id                 String                @id @default(uuid())
  subjectId          String
  academicPeriodId   String
  term               AcademicTerm
  title              String
  assessmentType     AssessmentType        @default(EXAM)
  instructions       String?
  totalPoints        Int
  durationMinutes    Int
  roomCode           String                @unique
  requireCamera      Boolean               @default(false)
  requireMicrophone  Boolean               @default(false)
  appPolicyMode      AppPolicyMode         @default(BLACKLIST)
  appPolicyList      String[]              @default([])
  status             ExamStatus            @default(DRAFT)
  scheduledAt        DateTime?
  endsAt             DateTime?
  sourceType         ExamSourceType        @default(MANUAL)
  externalFormUrl    String?
  showCorrectAnswers Boolean               @default(false)
  randomizeQuestions Boolean               @default(false)
  randomizeOptions   Boolean               @default(false)
  versionGroupId     String                @default(uuid())
  version            Int                   @default(1)
  publishedAt        DateTime?
  sessionsArchivedAt DateTime?
  createdAt          DateTime              @default(now())
  subject            Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicPeriod     AcademicPeriod        @relation(fields: [academicPeriodId], references: [id])
  questions          Question[]
  sessions           ExamSession[]
  studentOverrides   ExamStudentOverride[]
  questionBankCopies QuestionBankItem[]    @relation("QuestionBankSourceExam")

  @@unique([versionGroupId, version])
  @@index([subjectId])
  @@index([academicPeriodId, term])
  @@index([sessionsArchivedAt])
  @@map("exams")
}

model ExamStudentOverride {
  id               String   @id @default(uuid())
  examId           String
  studentId        String
  extraTimeMinutes Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_student_overrides")
}

model QuestionBankItem {
  id            String             @id @default(uuid())
  teacherId     String
  subjectId     String?
  sourceExamId  String?
  type          QuestionType
  prompt        String
  points        Int                @default(1)
  isRequired    Boolean            @default(true)
  correctAnswer Json?
  rubric        String?
  options       Json?
  topics        String[]           @default([])
  difficulty    QuestionDifficulty @default(MEDIUM)
  source        ExamSourceType     @default(MANUAL)
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  teacher       User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject       Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceExam    Exam?              @relation("QuestionBankSourceExam", fields: [sourceExamId], references: [id], onDelete: SetNull)

  @@index([teacherId, archivedAt])
  @@index([subjectId])
  @@index([sourceExamId, archivedAt])
  @@map("question_bank_items")
}

model AcademicPeriod {
  id            String               @id @default(uuid())
  institutionId String?
  academicYear  String
  semester      Semester
  status        AcademicPeriodStatus @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  closedAt      DateTime?
  createdAt     DateTime             @default(now())
  exams         Exam[]

  @@unique([institutionId, academicYear, semester])
  @@index([institutionId])
  @@index([status])
  @@map("academic_periods")
}

model Question {
  id            String           @id @default(uuid())
  examId        String
  type          QuestionType
  order         Int
  points        Int
  prompt        String
  isRequired    Boolean          @default(true)
  /// Null for multiple-choice and essay questions; its JSON shape varies by question type.
  correctAnswer Json?
  rubric        String?
  source        ExamSourceType   @default(MANUAL)
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  answers       Answer[]

  @@unique([examId, order])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  label      String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model Submission {
  id              String         @id @default(uuid())
  sessionId       String         @unique
  submittedAt     DateTime?
  totalScore      Int?
  maxScore        Int
  gradeStatus     GradeStatus    @default(UNGRADED)
  mode            SubmissionMode @default(MANUAL)
  deletedAt       DateTime?
  teacherFeedback String?        @db.Text
  session         ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers         Answer[]

  @@index([deletedAt, submittedAt])
  @@map("submissions")
}

model Answer {
  id                String      @id @default(uuid())
  submissionId      String
  questionId        String
  responseText      String?
  selectedOptionIds String[]    @default([])
  awardedPoints     Int?
  aiSuggestedPoints Int?
  aiJustification   String?
  gradeStatus       GradeStatus @default(UNGRADED)
  submission        Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question          Question    @relation(fields: [questionId], references: [id])

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@map("answers")
}

model ExamSession {
  id                        String                   @id @default(uuid())
  examId                    String
  studentId                 String
  startedAt                 DateTime
  endedAt                   DateTime?
  status                    SessionStatus
  timerStartedAt            DateTime?
  activeStartedAt           DateTime?
  lastHeartbeatAt           DateTime?
  remainingSeconds          Int?
  extraTimeSeconds          Int                      @default(0)
  questionOrder             String[]                 @default([])
  optionOrder               Json?
  isLocked                  Boolean                  @default(false)
  resumeAuthorizedAt        DateTime?
  integrityArchivedAt       DateTime?
  studentActivityArchivedAt DateTime?
  proctorReviewDecision     ProctorReviewDecision    @default(PENDING)
  proctorReviewedAt         DateTime?
  proctorReviewedById       String?
  exam                      Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student                   User                     @relation(fields: [studentId], references: [id])
  recording                 Recording?
  submission                Submission?
  events                    ProctoringEvent[]
  scoreHistory              SuspicionScoreSnapshot[]
  raiseHandRequests         RaiseHandRequest[]
  incidents                 Incident[]
  evidenceClips             EvidenceClip[]
  proctorReviews            ProctorReview[]
  proctorWarnings           ProctorWarning[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([studentId, studentActivityArchivedAt])
  @@index([proctorReviewDecision])
  @@index([status, lastHeartbeatAt])
  @@map("exam_sessions")
}

model ProctorReview {
  id               String                @id @default(uuid())
  sessionId        String
  teacherId        String
  previousDecision ProctorReviewDecision
  decision         ProctorReviewDecision
  createdAt        DateTime              @default(now())
  session          ExamSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher          User                  @relation("ProctorReviewTeacher", fields: [teacherId], references: [id])

  @@index([sessionId, createdAt])
  @@map("proctor_reviews")
}

model ProctorWarning {
  id             String      @id @default(uuid())
  sessionId      String
  teacherId      String
  message        String
  sentAt         DateTime    @default(now())
  acknowledgedAt DateTime?
  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher        User        @relation("ProctorWarningTeacher", fields: [teacherId], references: [id])

  @@index([sessionId, sentAt])
  @@map("proctor_warnings")
}

model Incident {
  id         String         @id @default(uuid())
  sessionId  String
  eventId    String?        @unique
  status     IncidentStatus @default(OPEN)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?
  session    ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("incidents")
}

model RaiseHandRequest {
  id         String      @id @default(uuid())
  sessionId  String
  reason     String?
  raisedAt   DateTime    @default(now())
  resolvedAt DateTime?
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, resolvedAt])
  @@map("raise_hand_requests")
}

model Recording {
  id            String          @id @default(uuid())
  sessionId     String          @unique
  storagePath   String
  durationSec   Int?
  fileSizeBytes BigInt?
  status        RecordingStatus
  session       ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

model ProctoringEvent {
  id            String         @id @default(uuid())
  sessionId     String
  type          EventType
  intensity     Float?
  metadata      Json?
  evidencePath  String?
  occurredAt    DateTime
  session       ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidenceClips EvidenceClip[]

  @@index([sessionId, occurredAt])
  @@map("proctoring_events")
}

model EvidenceClip {
  id            String             @id @default(uuid())
  sessionId     String
  eventId       String
  phase         EvidenceClipPhase
  storagePath   String
  startedAt     DateTime
  endedAt       DateTime
  fileSizeBytes BigInt
  status        EvidenceClipStatus @default(UPLOADING)
  createdAt     DateTime           @default(now())
  session       ExamSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event         ProctoringEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, phase])
  @@index([sessionId, startedAt])
  @@map("evidence_clips")
}

model SuspicionScoreSnapshot {
  id                  String      @id @default(uuid())
  sessionId           String
  score               Int
  tier                RiskTier
  contributingFactors Json
  computedAt          DateTime
  session             ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, computedAt])
  @@map("suspicion_score_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  dedupeKey String?  @unique
  link      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
