{
  "name": "proctorx",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:ai": "powershell -ExecutionPolicy Bypass -File apps/ai-service/scripts/dev.ps1",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma --workspace=backend -- migrate dev",
    "db:studio": "npm run prisma --workspace=backend -- studio",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "test": "npm run test --workspace=backend && npm run test --workspace=desktop",
    "test:ai": "cd apps/ai-service && .venv/Scripts/python -m pytest -q",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=web && npm run typecheck --workspace=desktop"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
